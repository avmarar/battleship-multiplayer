{
  "name": "battleship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel emulators dev:next",
    "dev:next": "next dev",
    "emulators": "firebase emulators:start --only firestore,auth --project battleship-multiplayer-demo",
    "test:rules:run": "node tests/firestore/rules.test.js",
    "test:rules": "npx firebase emulators:exec --project battleship-multiplayer-demo --only firestore \"npm run test:rules:run\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "firebase": "^12.6.0",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
